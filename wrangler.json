{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pr-statusreport",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
